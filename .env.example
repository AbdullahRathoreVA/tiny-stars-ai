# Flip to "true" only for a real production deploy of this codebase.
# Left unset, every page is noindex and robots.txt disallows all — so the demo
# can never compete with the live tinystars.ca in search results.
PUBLIC_SITE_URL=https://tinystars.ca
PUBLIC_INDEXABLE=false

# --- Future AI provider wiring (NOT required: the demo runs fully offline) ---
# The concierge ships with a local, deterministic, retrieval-only provider.
# These are read server-side only and must never be exposed to the browser.
# AI_PROVIDER=local        # local | anthropic | openai | google
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Star Guide, hosted rewrite pass (optional) -----------------------------
# Leave all of this unset and the concierge runs exactly as it shipped: local,
# offline, retrieval-only. Set it and answers get warmer wording, with the same
# facts — retrieval and both guardrail passes still run server-side.
#
# Get a free key at https://console.groq.com/keys, then add it in Vercel:
#   Project -> Settings -> Environment Variables -> GROQ_API_KEY
# Never commit a key, and never paste one into a chat or an issue.
# PUBLIC_AI_PROVIDER=groq          # 'groq' to use the endpoint, unset for local
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Private CRM (Tiny Stars Command Center) --------------------------------
# BOTH must be set for the site to forward registrations. Leave either unset and
# /api/registration answers {"delivered":false,"reason":"not-configured"} and the
# enrol flow stays exactly as it ships: a preview that submits nothing.
#
# CRM_INGEST_URL is the CRM's /api/v1/ingest endpoint. It is NEVER a public URL:
# point it at a private/VPN/Tailscale address the function can reach.
# CRM_INGEST_SECRET must match CRM_INGEST_SECRET in the CRM's own environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-side only. Never prefix these with PUBLIC_.
# CRM_INGEST_URL=
# CRM_INGEST_SECRET=
