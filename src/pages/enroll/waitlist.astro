---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { programs } from '../../data/programs';
import { site } from '../../data/site';
import { breadcrumbSchema, organizationSchema } from '../../lib/schema';
import { crmConfigured } from '../../lib/crm/forward';

const schema = [
  organizationSchema,
  breadcrumbSchema([
    { name: 'Enrol', href: '/enroll' },
    { name: 'Waitlist', href: '/enroll/waitlist' },
  ]),
];

/**
 * Whether a CRM is actually wired up behind this page, decided at build time
 * from the server-side environment. The form's own confirmation still waits for
 * a real delivery before it claims one — this only decides which promise the
 * page makes before you press anything. A page that says "nothing is sent"
 * while quietly sending is the one failure mode worth spending a branch on.
 */
const live = crmConfigured();
---

<Base
  title="Join the waitlist | Tiny Stars Daycare"
  description="Register your interest on the Tiny Stars Daycare waitlist in Grande Prairie. What the waitlist is, what it is not, and what happens after you join."
  schema={schema}
>
  <PageHero
    eyebrow="Waitlist"
    title="If the room you want is full"
    lede="A waitlist place registers your interest. It is not a reservation, and nobody can honestly tell you how long it will take — so we won't pretend otherwise."
    crumbs={[
      { name: 'Enrol', href: '/enroll' },
      { name: 'Waitlist', href: '/enroll/waitlist' },
    ]}
  />

  <!-- ------------------------------------------------------ expectations -->
  <section class="section section--tight" aria-labelledby="exp-title">
    <div class="container container--narrow">
      <h2 id="exp-title" class="visually-hidden">What the waitlist is and is not</h2>
      <div class="isnt" data-reveal>
        <div class="isnt__col isnt__col--is">
          <h3><Icon name="check-circle" size={18} /> What it is</h3>
          <ul>
            <li>A record of your interest, your child's age and when you'd want to start</li>
            <li>A way for the team to contact you when something opens up</li>
            <li>Free, and not binding on you</li>
          </ul>
        </div>
        <div class="isnt__col isnt__col--isnt">
          <h3><Icon name="x" size={18} /> What it isn't</h3>
          <ul>
            <li>A guarantee of a place</li>
            <li>A strict numbered queue — age group and schedule both matter</li>
            <li>A substitute for a tour, which is still worth doing while you wait</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ form -->
  <section class="section section--tight" aria-labelledby="wl-title">
    <div class="container container--narrow">
      <h2 id="wl-title" class="visually-hidden">Waitlist form</h2>

      <div class="notice notice--demo" data-reveal>
        <Icon name="sparkles" size={20} />
        <span>
          {live ? (
            <Fragment>
              <strong>This adds you to the real waitlist.</strong>
              Tiny Stars does not publish waitlist lengths or availability, so nothing here
              will give you a date. To ask where you stand, call {site.phone.label}.
            </Fragment>
          ) : (
            <Fragment>
              <strong>Preview only.</strong>
              Nothing here reaches Tiny Stars. To actually join the waitlist today, call
              the director on {site.phone.label}.
            </Fragment>
          )}
        </span>
      </div>

      <div class="flow panel mt-l" data-flow>
        <div class="flow__progress">
          <div class="progress">
            <span class="progress__label" data-step-label>Step 1 of 3</span>
            <div class="progress__track">
              <div class="progress__fill" data-progress style="width:33%"></div>
            </div>
          </div>
        </div>

        <p class="visually-hidden" role="status" aria-live="polite" data-announce></p>

        <fieldset class="step is-active" data-step="1">
          <legend>
            <span class="step__n">1</span>
            <span>
              <strong>Which group, and when?</strong>
              <small>Both change how quickly something is likely to come free.</small>
            </span>
          </legend>
          <div class="field">
            <div class="choices choices--grid" data-required-group="program" data-error-empty="Pick the group you're waiting for.">
              {programs.map((p) => (
                <label class="choice">
                  <input type="radio" name="program" value={p.name} data-label={`${p.name} · ${p.ageLabel}`} />
                  <span class="choice__box">{p.name}<small>{p.ageLabel}</small></span>
                </label>
              ))}
            </div>
            <p class="field__error"></p>
          </div>
          <div class="field">
            <label class="field__label" for="w-start">Earliest date you'd take a place</label>
            <input class="input" type="date" id="w-start" name="startDate" data-required data-error-empty="Give us a date to work from." />
            <p class="field__error"></p>
          </div>
        </fieldset>

        <fieldset class="step" data-step="2" hidden>
          <legend>
            <span class="step__n">2</span>
            <span>
              <strong>How do we reach you?</strong>
              <small>Waitlists can move suddenly — a phone number matters more than usual.</small>
            </span>
          </legend>
          <div class="field">
            <label class="field__label" for="w-name">Your name</label>
            <input class="input" type="text" id="w-name" name="parentName" autocomplete="name" data-required />
            <p class="field__error"></p>
          </div>
          <div class="field">
            <label class="field__label" for="w-email">Email</label>
            <input class="input" type="email" id="w-email" name="email" autocomplete="email" inputmode="email" data-required />
            <p class="field__error"></p>
          </div>
          <div class="field">
            <label class="field__label" for="w-phone">Phone</label>
            <input class="input" type="tel" id="w-phone" name="phone" autocomplete="tel" inputmode="tel" data-required />
            <p class="field__error"></p>
          </div>
        </fieldset>

        <fieldset class="step" data-step="3" hidden>
          <legend>
            <span class="step__n">3</span>
            <span>
              <strong>Check it over</strong>
              <small>Then we'll show you what would happen next.</small>
            </span>
          </legend>
          <dl class="review" data-review></dl>
        </fieldset>

        <div class="result" data-result hidden></div>

        <div class="flow__nav" data-nav>
          <button type="button" class="btn btn--quiet" data-back hidden>
            <Icon name="chevron" size={16} class="flip" /> Back
          </button>
          <button type="button" class="btn btn--primary" data-next data-final-label="Join the waitlist">Continue</button>
        </div>
      </div>

      <div class="notice notice--info mt-l" data-reveal>
        <Icon name="bulb" size={20} />
        <span>
          <strong>While you wait, tour anyway.</strong>
          Families who have already visited tend to say yes faster when a place appears —
          and if the centre turns out not to suit you, better to find out now.
        </span>
      </div>
    </div>
  </section>
</Base>

<style>
  .isnt { display: grid; gap: var(--space-m); }
  @media (min-width: 720px) { .isnt { grid-template-columns: 1fr 1fr; } }

  .isnt__col {
    padding: var(--space-m);
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
  }
  .isnt__col--is { background: var(--ok-100); border-color: color-mix(in oklab, var(--ok-600) 22%, transparent); }
  .isnt__col--isnt { background: var(--warn-100); border-color: color-mix(in oklab, var(--warn-600) 24%, transparent); }
  .isnt__col h3 {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 0.75rem;
  }
  .isnt__col--is h3 { color: var(--ok-600); }
  .isnt__col--isnt h3 { color: var(--warn-600); }
  .isnt__col ul { padding-left: 1.15rem; display: grid; gap: 0.45rem; }
  .isnt__col li { font-size: var(--step--1); line-height: var(--leading-normal); color: var(--ink-700); }
</style>

<script>
  import { StepFlow, esc } from '../../lib/stepflow';
  import { track } from '../../lib/analytics';

  const root = document.querySelector<HTMLElement>('[data-flow]')!;
  const reviewEl = root.querySelector<HTMLElement>('[data-review]')!;

  const FIELDS = [
    { key: 'program', label: 'Program', step: 1 },
    { key: 'startDate', label: 'Earliest start', step: 1 },
    { key: 'parentName', label: 'Your name', step: 2 },
    { key: 'email', label: 'Email', step: 2 },
    { key: 'phone', label: 'Phone', step: 2 },
  ];

  track('waitlist_start');

  const flow = new StepFlow({
    root,
    draftKey: 'ts:waitlist-draft',
    onStep(step, total) {
      if (step === total) renderReview();
    },
    onComplete(data) {
      track('waitlist_complete', { program: data.program ?? '' });
      flow.clearDraft();

      // NOT awaited: the confirmation is on screen immediately and the wording
      // upgrades itself if the CRM accepted it. With no CRM configured the
      // endpoint answers "not-configured" and the preview wording stands.
      submitToCrm(data).then((delivered) => {
        if (delivered) markDelivered();
      });

      flow.finish(
        `<div class="done__icon">
           <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
         </div>
         <span class="badge badge--demo">Preview — nothing was sent</span>
         <h3 style="font-size:var(--step-3);margin-top:.75rem">What would happen next</h3>
         <p class="lede" style="margin-top:.6rem">
           In the live version Tiny Stars would add
           <strong>${esc(flow.labelFor('parentName') || 'you')}</strong> to the waitlist for
           <strong>${esc(flow.labelFor('program') || 'your chosen group')}</strong> and contact
           you when a place matching your dates comes free.
         </p>

         <div class="notice notice--warn" style="margin-top:var(--space-l)">
           <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4.5 2.8 20h18.4Z"/><path d="M12 10v4"/><path d="M12 17.2v.1"/></svg>
           <span>
             <strong>No timeframe is promised here, and none should be.</strong>
             Tiny Stars does not publish waitlist lengths or availability, and a number
             invented by a website would be worthless to you.
           </span>
         </div>

         <div class="cluster" style="margin-top:var(--space-l)">
           <a class="btn btn--primary" href="tel:+17802301599" data-track="phone_click">Join for real — call (780) 230-1599</a>
           <a class="btn btn--ghost" href="/enroll/book-a-tour" data-track="tour_cta_click" data-track-label="after-waitlist">Book a tour meanwhile</a>
         </div>`,
        'Preview complete. Nothing was sent to Tiny Stars.'
      );
    },
  });

  /**
   * Posts to our own /api/waitlist, which signs and forwards it to the private
   * CRM. Returns false for every failure mode, so a submission problem can
   * never turn into a broken confirmation screen for a parent.
   */
  async function submitToCrm(data: Record<string, string>): Promise<boolean> {
    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          parentName: data.parentName,
          email: data.email,
          phone: data.phone,
          program: flow.labelFor('program') || data.program,
          startDate: data.startDate,
        }),
      });
      const body = (await res.json()) as { delivered?: boolean };
      return body.delivered === true;
    } catch {
      return false;
    }
  }

  /**
   * Swaps the preview wording for a real confirmation, once one is earned.
   *
   * The warning about timeframes stays exactly as it is. Being on the list is
   * now true; a promise about how long it takes still is not, and delivery
   * does not turn an unknown into a known.
   */
  function markDelivered() {
    const badge = root.querySelector<HTMLElement>('.badge--demo');
    if (badge) {
      badge.textContent = 'Received by Tiny Stars';
      badge.classList.remove('badge--demo');
    }
    const heading = root.querySelector<HTMLElement>('.done h3, h3');
    if (heading) heading.textContent = 'You are on the list';
    const lede = root.querySelector<HTMLElement>('.done .lede, .lede');
    if (lede) {
      lede.innerHTML =
        `Tiny Stars has added <strong>${esc(flow.labelFor('parentName') || 'you')}</strong> to the ` +
        `waitlist for <strong>${esc(flow.labelFor('program') || 'your chosen group')}</strong> and ` +
        `will contact you when a place matching your dates comes free.`;
    }
  }

  function renderReview() {
    reviewEl.innerHTML =
      FIELDS.map(({ key, label, step }) => {
        const value = flow.labelFor(key);
        if (!value) return '';
        return `<div><dt>${label}</dt><dd>${esc(value)} <button type="button" class="review__edit" data-goto="${step}">Change</button></dd></div>`;
      })
        .filter(Boolean)
        .join('') || '<div><dt>Nothing yet</dt><dd>Go back and fill in the earlier steps.</dd></div>';

    reviewEl.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((btn) =>
      btn.addEventListener('click', () => flow.goTo(Number(btn.dataset.goto)))
    );
  }

  const start = root.querySelector<HTMLInputElement>('#w-start');
  if (start) start.min = new Date().toISOString().slice(0, 10);
</script>
