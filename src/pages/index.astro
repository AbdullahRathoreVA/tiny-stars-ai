---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import IntentPicker from '../components/IntentPicker.astro';
import AgeMatch from '../components/AgeMatch.astro';
import MediaStrip from '../components/MediaStrip.astro';
import DayTimeline from '../components/DayTimeline.astro';
import HeroAsk from '../components/HeroAsk.astro';
import { site, trustMarkers, policyFacts } from '../data/site';
import { organizationSchema, websiteSchema } from '../lib/schema';
import Stage3D from '../components/three/Stage3D.astro';
import Universe from '../components/Universe.astro';

const values = [
  {
    icon: 'shield',
    title: 'Safe',
    line: 'Feel confident when you say goodbye.',
    body: 'Licensed and insured, with published policies covering surveillance, pick-up, pets and behaviour — so you can read the rules before you commit to them.',
    href: '/why/trust-centre',
    cta: 'See the Trust Centre',
  },
  {
    icon: 'heart',
    title: 'Caring',
    line: 'Know your child is seen, not just supervised.',
    body: 'Tiny Stars hires educators who, in their own words, “truly love children” — and treats teachers as part of the family a child grows up around.',
    href: '/why',
    cta: 'Meet the philosophy',
  },
  {
    icon: 'bulb',
    title: 'Learning',
    line: 'Watch curiosity turn into confidence.',
    body: 'A curriculum that goes from first lessons in sharing to the milestone of writing their own name — preparing children for kindergarten and what comes after.',
    href: '/learning',
    cta: 'The learning journey',
  },
  {
    icon: 'palette',
    title: 'Play',
    line: 'Let childhood feel like childhood.',
    body: 'Hands-on exploration, creative work, outdoor time and friendships — the parts of the day children actually tell you about at dinner.',
    href: '/day',
    cta: 'A day at Tiny Stars',
  },
];

const schema = [organizationSchema, websiteSchema];
---

<Base
  title="Tiny Stars Daycare | Childcare in Grande Prairie, Alberta"
  description="Family-owned, licensed and insured daycare in Grande Prairie for children 12 months to 12 years. Five programs, published policies, and 30-minute tours."
  schema={schema}
>
  <!-- ============================================================ HERO -->
  <section class="hero">
    <!-- Ambient 3D layer. The CSS starfield inside is the fallback and stays in
         the DOM: if WebGL is missing or motion is reduced, this is the hero. -->
    <Stage3D scene="hero" fill={true} decorative={true}>
      <div class="starfield">
        <span style="--s:3px;left:12%;top:18%;--d:4.2s;--o:.8"></span>
        <span style="--s:2px;left:26%;top:62%;--d:5.4s;--delay:.8s;--o:.55"></span>
        <span style="--s:4px;left:44%;top:12%;--d:4.8s;--delay:1.4s;--o:.7"></span>
        <span style="--s:2px;left:62%;top:70%;--d:6s;--delay:.3s;--o:.5"></span>
        <span style="--s:3px;left:78%;top:24%;--d:5.1s;--delay:2s;--o:.65"></span>
        <span style="--s:2px;left:90%;top:52%;--d:4.6s;--delay:1.1s;--o:.6"></span>
      </div>
    </Stage3D>

    <div class="container container--wide hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--plain hero__eyebrow">
          <Icon name="pin" size={14} />
          {site.address.city}, Alberta · Ages 12 months – 12 years
        </p>

        <h1>A place where your child is <em>known</em>.</h1>

        <p class="hero__lede">
          Family-owned childcare in Grande Prairie — licensed, insured, and built around
          the kind of care you'd give yourself if you could stay.
        </p>

        <div class="hero__actions">
          <a href="/enroll/book-a-tour" class="btn btn--primary btn--lg" data-track="tour_cta_click" data-track-label="hero">
            <Icon name="calendar" size={19} />
            Book a tour
          </a>
          <a href="/programs" class="btn btn--ghost btn--lg">Explore programs</a>
        </div>

        <!-- The assistant, in the hero, answering in place. Replaces the link
             that used to sit here and only opened the panel. -->
        <HeroAsk />

        <ul class="hero__trust">
          {trustMarkers.map((t) => (
            <li>
              <Icon name={t.icon as any} size={15} />
              {t.label}
            </li>
          ))}
        </ul>
      </div>

      <div class="hero__media depth-scope">
        <figure class="hero__figure hero__figure--main parallax" data-parallax="0.35">
          <img
            src="/assets/images/sections/who-we-are.webp"
            alt="The fenced outdoor play area at Tiny Stars seen from above: green turf running the length of the yard, climbing frames, a picnic table and a shade canopy"
            width="720"
            height="900"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <figure class="hero__figure hero__figure--sub parallax" data-parallax="0.9">
          <img
            src="/assets/images/gallery/gallery-6.webp"
            alt="A Tiny Stars classroom with a large illustrated world map on the wall and shelving units filled with labelled storage bins"
            width="360"
            height="270"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="hero__chip">
          <Icon name="clock" size={16} />
          <span><strong>30-minute tours</strong><small>Book one this week</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================== AGE MATCH -->
  <AgeMatch />

  <!-- ====================================================== MEDIA STRIP -->
  <MediaStrip />

  <!-- ========================================================= THE DAY -->
  <DayTimeline />

  <!-- =========================================================== VALUES -->
  <section class="section" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Why families choose Tiny Stars</p>
        <h2 id="values-title">Four things every parent is really asking about</h2>
        <p class="lede">
          Not features. The questions you actually lie awake thinking about before you
          hand someone your child.
        </p>
      </div>

      <div class="values depth-scope">
        {values.map((v, i) => (
          <article class="value depth" data-tilt data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="value__icon"><Icon name={v.icon as any} size={22} /></span>
            <h3>{v.title}</h3>
            <p class="value__line">{v.line}</p>
            <p class="value__body">{v.body}</p>
            <a href={v.href} class="value__cta">
              {v.cta}
              <Icon name="arrow" size={15} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================== TRUST -->
  <section class="section trust" aria-labelledby="trust-title">
    <div class="container">
      <div class="trust__grid">
        <figure class="trust__media" data-reveal>
          <img
            src="/assets/images/sections/health-and-safety.webp"
            alt="The full perimeter fence around the Tiny Stars play area, enclosing the turf and play equipment on every side"
            width="640"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="trust__copy" data-reveal>
          <p class="eyebrow eyebrow--teal">Trust, in writing</p>
          <h2 id="trust-title">The things we can prove — and the things only the team can tell you</h2>
          <p class="lede">
            Most daycare websites are confident about everything. This one is precise
            about what is published, and honest about what isn't.
          </p>

          <ul class="trust__list">
            {policyFacts.slice(0, 3).map((f) => (
              <li>
                <Icon name="check-circle" size={18} />
                <span>
                  {f.claim}
                  <small>{f.source}</small>
                </span>
              </li>
            ))}
          </ul>

          <div class="notice notice--warn mt-m">
            <Icon name="alert" size={18} />
            <span>
              <strong>Not published anywhere on the Tiny Stars site:</strong>
              fees, current availability, educator ratios, opening time, menus and staff
              credentials. We won't guess at any of them — the team will tell you directly.
            </span>
          </div>

          <div class="cluster mt-m">
            <a href="/why/trust-centre" class="btn btn--teal">Open the Trust Centre</a>
            <a href={site.phone.href} class="btn btn--quiet" data-track="phone_click">
              <Icon name="phone" size={16} /> {site.phone.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= UNIVERSE -->
  <!-- The star-map navigation is a desktop showpiece. On a phone it was a
       340px empty box above a list that already says the same thing, so the
       chips above are the mobile version of it. Hidden at this width means the
       mount is zero-sized, the observer never fires, and three.js is never
       fetched on mobile at all. -->
  <div class="wide-only">
    <Universe />
  </div>

  <!-- ====================================================== STAR GUIDE -->
  <section class="section guide" aria-labelledby="guide-title">
    <div class="container">
      <div class="guide__panel">
        <div class="starfield" aria-hidden="true">
          <span style="--s:3px;left:14%;top:26%;--d:4.4s;--o:.6"></span>
          <span style="--s:2px;left:36%;top:70%;--d:5.2s;--delay:1s;--o:.45"></span>
          <span style="--s:4px;left:66%;top:20%;--d:4.9s;--delay:1.7s;--o:.6"></span>
          <span style="--s:2px;left:86%;top:64%;--d:5.8s;--delay:.5s;--o:.4"></span>
        </div>

        <div class="guide__copy">
          <p class="eyebrow eyebrow--plain guide__eyebrow">
            <Icon name="sparkles" size={15} /> Stella
          </p>
          <h2 id="guide-title">An assistant that would rather say “I don't know”</h2>
          <p>
            Ask it anything about Tiny Stars. It answers from published information and
            shows you the source. When something hasn't been published — fees, availability,
            ratios — it says so and puts you through to a person instead of guessing.
          </p>
          <div class="guide__actions">
            <button type="button" class="btn btn--primary" data-concierge-open>
              <Icon name="chat" size={18} />
              Ask Stella
            </button>
            <a href="/command-center" class="btn btn--on-dark">
              See how it works
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>

        <ul class="guide__samples wide-only-flex" aria-label="Example questions">
          {[
            'My child is 2 and I’m looking for full-time care',
            'What time do you close?',
            'Are there cameras in the daycare?',
            'How much does it cost?',
          ].map((q) => (
            <li>
              <button type="button" class="guide__sample" data-ask={q}>
                <Icon name="question" size={15} />
                {q}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================= CTA -->
  <section class="section cta" aria-labelledby="cta-title">
    <div class="container container--narrow text-center">
      <p class="eyebrow eyebrow--plain mx-auto" data-reveal>The next step</p>
      <h2 id="cta-title" data-reveal>Nothing on a website replaces standing in the room</h2>
      <p class="lede mx-auto mt-s" data-reveal>
        Thirty minutes, in person, with the people who'd be looking after your child.
        Bring your questions — the awkward ones especially.
      </p>
      <div class="cluster mt-l" style="justify-content:center" data-reveal>
        <a href="/enroll/book-a-tour" class="btn btn--primary btn--lg" data-track="tour_cta_click" data-track-label="footer-cta">
          <Icon name="calendar" size={19} />
          Book a tour
        </a>
        <a href="/enroll/tour-guide" class="btn btn--ghost btn--lg">What to ask on a tour</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- hero -- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1rem + 6vw, 5.5rem) clamp(3rem, 1.5rem + 6vw, 6rem);
    background:
      radial-gradient(90rem 40rem at 78% -12%, var(--violet-100) 0%, transparent 58%),
      radial-gradient(70rem 34rem at 8% 12%, var(--blush-100) 0%, transparent 50%),
      radial-gradient(50rem 30rem at 50% 100%, var(--gold-200) 0%, transparent 60%),
      var(--bg);
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    /* Explicit, and floored at 0. Without this the column takes its width from
       the widest min-content inside it — the ask box's nowrap suggestion chips
       — and the hero copy renders 558px wide inside a 375px phone. body has
       overflow-x: hidden, so the page does not scroll sideways to show it: it
       is simply cut off, which is what a parent reports as "I can't see it". */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }
  .hero__grid > * { min-width: 0; }

  .hero__eyebrow { align-items: flex-start; line-height: 1.5; }
  .hero__eyebrow :global(svg) { flex: none; margin-top: 0.15em; }

  .hero__copy h1 {
    font-size: var(--step-6);
    margin-top: var(--space-s);
  }
  .hero__copy h1 em {
    font-style: italic;
    color: var(--coral-600);
  }

  .hero__lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 40ch;
    line-height: var(--leading-snug);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-l);
  }

  .hero__ask {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: var(--space-m);
    padding: 0.55rem 0.95rem 0.55rem 0.75rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--cream-50) 70%, transparent);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .hero__ask:hover { border-color: var(--coral-500); color: var(--ink-800); border-style: solid; }
  .hero__ask :global(svg) { color: var(--coral-600); flex: none; }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.15rem;
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
    list-style: none;
    padding-left: 0;
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-700);
  }
  .hero__trust :global(svg) { color: var(--teal-600); }

  /* ------------------------------------------------------ hero, phone --
     The desktop hero is a two-column composition. Stacked on a phone it ran to
     1.5 screens before a parent reached anything actionable, and the photograph
     — the thing that says "this is a real place" — sat below the fold.
     So on small screens: tighter rhythm, one photograph promoted to a wide
     band right under the buttons, and the second inset figure dropped rather
     than shrunk, because two overlapping images at 390px is noise. */
  @media (max-width: 55rem) {
    .hero { padding-block: var(--space-l) var(--space-m); }
    .hero__grid { gap: var(--space-l); }
    .hero__copy h1 { font-size: var(--step-5); margin-top: var(--space-xs); }
    .hero__lede { margin-top: var(--space-s); font-size: var(--step-0); }
    .hero__actions { margin-top: var(--space-m); }
    .hero__actions .btn { flex: 1 1 100%; }
    .hero__ask { margin-top: var(--space-s); width: 100%; }
    .hero__trust {
      margin-top: var(--space-m);
      padding-top: var(--space-s);
      gap: 0.4rem 0.9rem;
    }
    .hero__figure--main { aspect-ratio: 16 / 10; }
    .hero__eyebrow { font-size: var(--step--2); }
    .hero__figure--sub { display: none; }
  }

  /* hero media */
  .hero__media { position: relative; }
  .hero__figure { margin: 0; border-radius: var(--radius-xl); overflow: hidden; }
  .hero__figure--main {
    box-shadow: var(--shadow-xl);
    aspect-ratio: 4 / 5;
  }
  .hero__figure--main img { width: 100%; height: 100%; object-fit: cover; }
  .hero__figure--sub {
    display: none;
    position: absolute;
    left: -2.5rem;
    bottom: 2.5rem;
    width: 13rem;
    aspect-ratio: 4 / 3;
    border: 6px solid var(--cream-100);
    box-shadow: var(--shadow-l);
    border-radius: var(--radius-l);
  }
  .hero__figure--sub img { width: 100%; height: 100%; object-fit: cover; }

  .hero__chip {
    position: absolute;
    right: -0.5rem;
    top: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-m);
    background: var(--cream-50);
    box-shadow: var(--shadow-l);
    border: 1px solid var(--border);
  }
  .hero__chip :global(svg) { color: var(--coral-600); flex: none; }
  .hero__chip strong { display: block; font-size: var(--step--1); line-height: 1.2; }
  .hero__chip small { font-size: var(--step--2); color: var(--text-muted); }

  @media (min-width: 860px) {
    .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-3xl); }
    .hero__figure--sub { display: block; }
  }

  /* ----------------------------------------------------------- values -- */
  .values {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin-top: var(--space-xl);
  }

  /* On a phone these four cards ran to nearly two full screens, which is a lot
     of scrolling to reach a trust section that says the same thing with
     evidence. Below 700px they collapse to a two-up grid of icon, title and
     one line; the paragraph is the page the card links to. */
  @media (max-width: 43.75rem) {
    /* Scoped through .values so these land after the .value__* rules further
       down this sheet. Equal specificity means source order decides, and a
       media query does not change that. */
    .values {
      /* minmax(0, …) so a long word cannot set the column floor. */
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-s);
      margin-top: var(--space-l);
    }
    .values .value { padding: var(--space-s); gap: 0.3rem; }
    .values .value h3 { font-size: var(--step-0); }
    .values .value__body { display: none; }
    .values .value__line { font-size: var(--step--1); font-weight: 600; }
    .values .value__icon { width: 34px; height: 34px; }
  }
  .value {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-m);
    border-radius: var(--radius-l);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .value:hover { box-shadow: var(--shadow-m); }
  @media not all and (hover: hover) and (pointer: fine) {
    .value { transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
    .value:active { transform: translateY(-3px); }
  }
  .value__icon {
    display: grid; place-items: center;
    width: 46px; height: 46px;
    border-radius: var(--radius-m);
    background: var(--coral-50);
    color: var(--coral-600);
    margin-bottom: 0.35rem;
  }
  .value h3 { font-size: var(--step-1); }
  .value__line { font-weight: 650; font-size: var(--step--1); color: var(--ink-800); }
  .value__body { font-size: var(--step--1); color: var(--text-muted); line-height: var(--leading-normal); flex: 1; }
  .value__cta {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: var(--step--1); font-weight: 650;
    text-decoration: none;
    margin-top: 0.35rem;
  }
  .value__cta :global(svg) { transition: transform var(--dur-fast) var(--ease-out); }
  .value:hover .value__cta :global(svg) { transform: translateX(3px); }

  /* --------------------------------------------------------- programs -- */
  .programs__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    align-items: flex-end;
    justify-content: space-between;
  }

  .pmore {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    background:
      linear-gradient(150deg, var(--ink-800), var(--ink-900));
    color: var(--cream-200);
    border-color: transparent;
  }
  .pmore:hover { color: var(--cream-100); }
  .pmore__icon {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border-radius: var(--radius-m);
    background: color-mix(in oklab, var(--gold-400) 18%, transparent);
    color: var(--gold-400);
    margin-bottom: 0.35rem;
  }
  .pmore strong { font-family: var(--font-display); font-size: var(--step-1); color: var(--cream-50); }
  .pmore > span:not(.pmore__icon):not(.pmore__cta) {
    font-size: var(--step--1); color: var(--cream-400); line-height: var(--leading-normal);
  }
  .pmore__cta {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: var(--step--1); font-weight: 650; color: var(--gold-400);
    margin-top: 0.35rem;
  }

  /* -------------------------------------------------------------- day -- */
  .day { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); align-items: start; }
  .day > * { min-width: 0; }

  .rhythm { list-style: none; padding: 0; display: grid; gap: 0.5rem; counter-reset: step; }
  .rhythm__step {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-m);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    position: relative;
  }
  .rhythm__step::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: -0.55rem; top: 50%;
    transform: translateY(-50%);
    width: 22px; height: 22px;
    display: none;
    place-items: center;
    border-radius: 50%;
    background: var(--ink-900);
    color: var(--cream-100);
    font-size: 0.65rem;
    font-weight: 700;
  }
  .rhythm__icon {
    display: grid; place-items: center;
    width: 38px; height: 38px;
    flex: none;
    border-radius: var(--radius-s);
    background: var(--cream-200);
    color: var(--coral-700);
  }
  .rhythm__text strong { display: block; font-size: var(--step--1); font-weight: 650; }
  .rhythm__text small {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem;
    font-size: var(--step--2); color: var(--text-muted); margin-top: 0.15rem;
  }

  @media (min-width: 900px) {
    .day { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); gap: var(--space-3xl); }
    .rhythm__step::before { display: grid; }
    .rhythm { padding-left: 0.55rem; }
  }

  /* ------------------------------------------------------------ trust -- */
  .trust__grid { display: grid; gap: var(--space-xl); align-items: center; }
  .trust__media {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-l);
    aspect-ratio: 4 / 4.5;
  }
