<script>
  // Sample questions on Stella's panel open the concierge pre-loaded.
  document.querySelectorAll<HTMLButtonElement>('.guide__sample[data-ask]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.dispatchEvent(
        new CustomEvent('ts:concierge-open', { detail: { ask: btn.dataset.ask } })
      );
    });
  });
</script>
