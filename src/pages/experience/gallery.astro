---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextStep from '../../components/NextStep.astro';
import Icon from '../../components/Icon.astro';
import { photos, categoryLabels, type GalleryCategory } from '../../data/gallery';
import { breadcrumbSchema, organizationSchema } from '../../lib/schema';
import Stage3D from '../../components/three/Stage3D.astro';

const categories = Object.keys(categoryLabels) as GalleryCategory[];
const counts = categories.map((c) => ({
  id: c,
  label: categoryLabels[c],
  n: photos.filter((p) => p.category === c).length,
}));

const schema = [
  organizationSchema,
  breadcrumbSchema([{ name: 'Gallery', href: '/experience/gallery' }]),
];
---

<Base
  title="Photo gallery | Inside Tiny Stars Daycare"
  description="Twenty photographs of the rooms, play spaces, kitchen and outdoor area at Tiny Stars Daycare in Grande Prairie — the actual spaces, photographed as they are."
  image="/assets/images/gallery/gallery-15.webp"
  schema={schema}
>
  <div class="phero-shell">
    <Stage3D scene="gallery" fill={true} decorative={true} />
    <PageHero
    eyebrow="Gallery"
    title="Twenty photographs of the actual rooms"
    lede="Not stock imagery, and not a stylist's version of a daycare. These are Tiny Stars' own photographs of the spaces your child would be in."
    crumbs={[{ name: 'Gallery', href: '/experience/gallery' }]}
  >
    <div class="notice notice--info" style="max-width:44rem">
      <Icon name="info" size={18} />
      <span>
        <strong>You won't see any children here.</strong>
        Tiny Stars' gallery is entirely photographs of the spaces, and we would not publish
        images of children without authorization. To see the rooms in use, come on a tour.
      </span>
    </div>
  </PageHero>
  </div>

  <section class="section section--tight" aria-labelledby="g-title">
    <div class="container">
      <h2 id="g-title" class="visually-hidden">Photographs, filterable by area</h2>

      <div class="gfilter" role="group" aria-label="Filter photographs by area">
        <button type="button" class="gchip" data-filter="all" aria-pressed="true">
          All <span class="gchip__n">{photos.length}</span>
        </button>
        {counts.map((c) => (
          <button type="button" class="gchip" data-filter={c.id} aria-pressed="false">
            {c.label} <span class="gchip__n">{c.n}</span>
          </button>
        ))}
      </div>

      <p class="visually-hidden" role="status" aria-live="polite" data-g-announce></p>

      <div class="gmasonry mt-l" data-grid>
        {photos.map((p, i) => (
          <button
            type="button"
            class={`gitem${p.wide ? ' gitem--wide' : ''}`}
            data-category={p.category}
            data-index={i}
            aria-label={`Open larger: ${p.caption}`}
          >
            <img
              src={p.src}
              alt={p.alt}
              width="640"
              height="480"
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="gitem__cap">
              <span>{p.caption}</span>
              <Icon name="search" size={15} />
            </span>
          </button>
        ))}
      </div>

      <div class="empty" data-empty hidden>
        <span class="empty__icon"><Icon name="camera" size={44} /></span>
        <h3>Nothing in that area yet</h3>
        <p>Tiny Stars hasn't published photographs of that space. Try another area, or see it for yourself.</p>
        <button type="button" class="btn btn--ghost" data-show-all>Show all photographs</button>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- lightbox -->
  <div class="lb" data-lightbox hidden>
    <div class="lb__scrim" data-lb-close></div>
    <div class="lb__panel" role="dialog" aria-modal="true" aria-label="Photograph viewer">
      <button type="button" class="lb__btn lb__btn--close" data-lb-close aria-label="Close viewer">
        <Icon name="x" size={20} />
      </button>
      <button type="button" class="lb__btn lb__btn--prev" data-lb-prev aria-label="Previous photograph">
        <Icon name="chevron" size={22} />
      </button>
      <figure class="lb__figure">
        <img data-lb-img src="" alt="" width="1200" height="900" />
        <figcaption data-lb-cap></figcaption>
      </figure>
      <button type="button" class="lb__btn lb__btn--next" data-lb-next aria-label="Next photograph">
        <Icon name="chevron" size={22} />
      </button>
      <p class="lb__count" data-lb-count></p>
    </div>
  </div>

  <NextStep
    title="Photographs only get you so far"
    lede="They cannot show you how a room sounds, or how quickly an educator notices a child who has gone quiet."
    primary={{ label: 'Book a tour', href: '/enroll/book-a-tour', desc: '30 minutes, in person' }}
    secondary={[
      { label: 'Take a look around', href: '/experience/virtual-tour', desc: 'Video walkthrough' },
      { label: 'A day at Tiny Stars', href: '/day', desc: 'What happens in these rooms' },
      { label: 'Programs by age', href: '/programs', desc: 'Which room your child would be in' },
    ]}
  />
</Base>

<style>
  .phero-shell { position: relative; isolation: isolate; }
  .phero-shell > :global(.stage3d--fill) { z-index: 0; opacity: 0.5; }
  .phero-shell > :global(section) { position: relative; z-index: 1; }

  /* ------------------------------------------------------------ filter */
  .gfilter { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .gchip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.55rem 1rem;
    min-height: 44px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-strong);
    background: var(--bg-raised);
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--ink-700);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .gchip:hover { border-color: var(--ink-700); color: var(--ink-900); }
  .gchip[aria-pressed='true'] {
    background: var(--ink-900);
    border-color: var(--ink-900);
    color: var(--cream-100);
  }
  .gchip__n {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--cream-200);
    color: var(--ink-700);
  }
  .gchip[aria-pressed='true'] .gchip__n { background: color-mix(in oklab, #fff 18%, transparent); color: var(--cream-100); }

  /* ---------------------------------------------------------- masonry */
  .gmasonry {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    grid-auto-flow: dense;
  }
  .gitem--wide { grid-column: span 2; }
  @media (max-width: 520px) { .gitem--wide { grid-column: span 1; } }

  .gitem {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--cream-300);
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .gitem[hidden] { display: none; }
  .gitem:hover { transform: translateY(-3px); box-shadow: var(--shadow-l); }
  .gitem img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .gitem:hover img { transform: scale(1.05); }

  .gitem__cap {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 2.5rem 0.85rem 0.75rem;
    background: linear-gradient(to top, color-mix(in oklab, var(--ink-900) 88%, transparent), transparent);
    color: var(--cream-100);
    font-size: var(--step--2);
    font-weight: 600;
    text-align: left;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .gitem:hover .gitem__cap,
  .gitem:focus-visible .gitem__cap { opacity: 1; transform: none; }
  .gitem__cap :global(svg) { flex: none; opacity: 0.8; }

  /* Touch devices never hover — show captions permanently. */
  @media (hover: none) {
    .gitem__cap { opacity: 1; transform: none; }
  }

  /* --------------------------------------------------------- lightbox */
  .lb { position: fixed; inset: 0; z-index: var(--z-overlay); }
  .lb__scrim {
    position: absolute; inset: 0;
    background: color-mix(in oklab, var(--ink-900) 92%, transparent);
    animation: lbFade var(--dur) var(--ease-out);
  }
  @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }

  .lb__panel {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-m);
  }

  .lb__figure {
    grid-column: 2;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    min-width: 0;
    max-height: 100%;
  }
  .lb__figure img {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-xl);
    object-fit: contain;
    animation: lbPop var(--dur-slow) var(--ease-out);
  }
  @keyframes lbPop { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .lb__scrim, .lb__figure img { animation: none; }
  }
  .lb__figure figcaption {
    color: var(--cream-200);
    font-size: var(--step--1);
    text-align: center;
    max-width: 46ch;
  }

  .lb__btn {
    display: grid; place-items: center;
    width: 48px; height: 48px;
    border: 0;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, #fff 12%, transparent);
    color: var(--cream-100);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .lb__btn:hover { background: color-mix(in oklab, #fff 24%, transparent); }
  .lb__btn--prev { grid-column: 1; }
  .lb__btn--prev :global(svg) { transform: rotate(180deg); }
  .lb__btn--next { grid-column: 3; }
  .lb__btn--close { position: absolute; top: var(--space-m); right: var(--space-m); z-index: 1; }

  .lb__count {
    position: absolute;
    bottom: var(--space-m);
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--step--2);
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .lb__panel { grid-template-columns: 1fr; grid-template-rows: 1fr auto; }
    .lb__figure { grid-column: 1; }
    .lb__btn--prev, .lb__btn--next {
      grid-column: 1;
      position: absolute;
      bottom: 3.25rem;
    }
    .lb__btn--prev { left: 25%; }
    .lb__btn--next { right: 25%; }
  }
</style>

<script>
  import { photos } from '../../data/gallery';
  import { track } from '../../lib/analytics';

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const items = Array.from(grid.querySelectorAll<HTMLButtonElement>('.gitem'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const emptyState = document.querySelector<HTMLElement>('[data-empty]')!;
  const announce = document.querySelector<HTMLElement>('[data-g-announce]')!;

  /* ----------------------------------------------------------- filter */
  function applyFilter(filter: string) {
    let shown = 0;
    items.forEach((el) => {
      const on = filter === 'all' || el.dataset.category === filter;
      el.hidden = !on;
      if (on) shown++;
    });

    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    emptyState.hidden = shown > 0;
    grid.hidden = shown === 0;
    announce.textContent = shown
      ? `Showing ${shown} photograph${shown === 1 ? '' : 's'}.`
      : 'No photographs in that area.';
  }

  chips.forEach((c) => c.addEventListener('click', () => applyFilter(c.dataset.filter!)));
  document.querySelector('[data-show-all]')?.addEventListener('click', () => applyFilter('all'));

  /* --------------------------------------------------------- lightbox */
  const lb = document.querySelector<HTMLElement>('[data-lightbox]')!;
  const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const lbCap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
  const lbCount = lb.querySelector<HTMLElement>('[data-lb-count]')!;

  let index = 0;
  let lastFocus: HTMLElement | null = null;

  /** Indices currently visible, so arrows walk the filtered set. */
  const visible = () => items.filter((el) => !el.hidden).map((el) => Number(el.dataset.index));

  function paint() {
    const p = photos[index];
    lbImg.src = p.src;
    lbImg.alt = p.alt;
    lbCap.textContent = p.caption;
    const list = visible();
    lbCount.textContent = `${list.indexOf(index) + 1} of ${list.length}`;
  }

  function open(i: number) {
    lastFocus = document.activeElement as HTMLElement;
    index = i;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    paint();
    track('gallery_open', { index: i });
    // `[data-lb-close]` is also on the scrim div, which is not focusable — target
    // the button explicitly so focus actually enters the dialog.
    lb.querySelector<HTMLButtonElement>('button[data-lb-close]')?.focus();
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  function step(dir: 1 | -1) {
    const list = visible();
    if (!list.length) return;
    const at = list.indexOf(index);
    index = list[(at + dir + list.length) % list.length];
    paint();
  }

  items.forEach((el) => el.addEventListener('click', () => open(Number(el.dataset.index))));
  lb.querySelectorAll('[data-lb-close]').forEach((el) => el.addEventListener('click', close));
  lb.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
  lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
  });

  // Swipe on touch devices.
  let startX = 0;
  lb.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
  }, { passive: true });

  // Keep focus inside the viewer.
  lb.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const list = Array.from(lb.querySelectorAll<HTMLElement>('button')).filter((b) => b.offsetParent !== null);
    if (!list.length) return;
    const first = list[0];
    const last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
