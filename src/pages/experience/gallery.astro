---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextStep from '../../components/NextStep.astro';
import Icon from '../../components/Icon.astro';
import { photos } from '../../data/gallery';
import MediaViewer from '../../components/MediaViewer.astro';
import {
  publishable,
  photoSrc,
  posterSrc,
  videoSrc,
  type MediaItem,
} from '../../data/media';
import { breadcrumbSchema, organizationSchema } from '../../lib/schema';
import { tracksFor } from '../../lib/tracks';
import Stage3D from '../../components/three/Stage3D.astro';

/**
 * Two sets of imagery, deliberately kept apart in the filters and joined in
 * one grid.
 *
 * The `rooms` set is Tiny Stars' own professional photography of empty spaces,
 * mirrored from its site. The `life` set is the photographs and clips the
 * centre supplied later, which do show children. They answer different
 * questions — "what is the place" and "what happens in it" — and they have
 * different provenance, so the chips let a parent ask for either.
 */

type Tile = {
  group: 'rooms' | 'life';
  filter: string;
  kind: 'photo' | 'video';
  thumb: string;
  alt: string;
  caption: string;
  wide?: boolean;
  viewer: Record<string, unknown>;
};

const roomTiles: Tile[] = photos.map((p) => ({
  group: 'rooms',
  filter: p.category === 'outdoors' ? 'outdoors' : 'rooms',
  kind: 'photo',
  thumb: p.src,
  alt: p.alt,
  caption: p.caption,
  wide: p.wide,
  viewer: { kind: 'photo', img: p.src, alt: p.alt, caption: p.caption },
}));

const lifeTiles: Tile[] = publishable().map((m) => ({
  group: 'life',
  filter: m.kind === 'video' ? 'video' : m.topic === 'playground' ? 'outdoors' : 'life',
  kind: m.kind,
  thumb: m.kind === 'video' ? posterSrc(m.id) : photoSrc(m.id, 700),
  alt: m.alt,
  caption: m.caption,
  viewer: {
    kind: m.kind,
    alt: m.alt,
    caption: m.caption,
    generated: !!m.generated,
    img: m.kind === 'photo' ? photoSrc(m.id, 1400) : '',
    video: m.kind === 'video' ? videoSrc(m.id) : '',
    poster: m.kind === 'video' ? posterSrc(m.id) : '',
    tracks: m.kind === 'video' ? tracksFor(m.id) : {},
  },
}));

const tiles: Tile[] = [...lifeTiles, ...roomTiles];

const FILTERS = [
  { id: 'all', label: 'Everything' },
  { id: 'life', label: 'Life here' },
  { id: 'rooms', label: 'The rooms' },
  { id: 'outdoors', label: 'Outdoors' },
  { id: 'video', label: 'Video' },
];
const counts = FILTERS.map((f) => ({
  ...f,
  n: f.id === 'all' ? tiles.length : tiles.filter((t) => t.filter === f.id).length,
}));

const schema = [
  organizationSchema,
  breadcrumbSchema([{ name: 'Gallery', href: '/experience/gallery' }]),
];
---

<Base
  title="Gallery | Inside Tiny Stars Daycare"
  description="Photographs and video from inside Tiny Stars Daycare in Grande Prairie — the rooms, the playground, and real days at the centre."
  image="/assets/images/gallery/gallery-15.webp"
  schema={schema}
>
  <div class="phero-shell">
    <Stage3D scene="gallery" fill={true} decorative={true} />
    <PageHero
    eyebrow="Gallery"
    title="Come and have a look around"
    lede="Tiny Stars' own photographs and clips — the rooms as they are, and the days that happen in them. No stock imagery anywhere on this page."
    crumbs={[{ name: 'Gallery', href: '/experience/gallery' }]}
  >
    <div class="notice notice--info" style="max-width:44rem">
      <Icon name="info" size={18} />
      <span>
        <strong>Two kinds of picture here, and it is worth knowing which is which.</strong>
        <em>The rooms</em> are professionally photographed and empty, so you can see the
        space itself. <em>Life here</em> was supplied by the centre and does show children
        at Tiny Stars. One clip in the set is AI-generated and is labelled as such when
        you open it.
      </span>
    </div>
  </PageHero>
  </div>

  <section class="section section--tight" aria-labelledby="g-title">
    <div class="container">
      <h2 id="g-title" class="visually-hidden">Photographs, filterable by area</h2>

      <div class="gfilter" role="group" aria-label="Filter by what you want to see">
        {counts.map((c, i) => (
          <button
            type="button"
            class="gchip"
            data-filter={c.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {c.label} <span class="gchip__n">{c.n}</span>
          </button>
        ))}
      </div>

      <p class="visually-hidden" role="status" aria-live="polite" data-g-announce></p>

      <div class="gmasonry mt-l" data-grid>
        {tiles.map((t, i) => (
          <button
            type="button"
            class={`gitem${t.wide ? ' gitem--wide' : ''}`}
            data-category={t.filter}
            data-index={i}
            aria-label={`Open: ${t.caption}`}
          >
            <img
              src={t.thumb}
              alt={t.alt}
              width="640"
              height="480"
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
            {t.kind === 'video' && (
              <span class="gitem__play" aria-hidden="true"><Icon name="play" size={17} /></span>
            )}
            <span class="gitem__cap">
              <span>{t.caption}</span>
              <Icon name={t.kind === 'video' ? 'play' : 'search'} size={15} />
            </span>
          </button>
        ))}
      </div>

      <div class="empty" data-empty hidden>
        <span class="empty__icon"><Icon name="camera" size={44} /></span>
        <h3>Nothing in that area yet</h3>
        <p>Tiny Stars hasn't published photographs of that space. Try another area, or see it for yourself.</p>
        <button type="button" class="btn btn--ghost" data-show-all>Show all photographs</button>
      </div>
    </div>
  </section>

  <script type="application/json" data-gallery-viewer set:html={JSON.stringify(tiles.map((t) => t.viewer))} />

  <MediaViewer />

  <NextStep
    title="Photographs only get you so far"
    lede="They cannot show you how a room sounds, or how quickly an educator notices a child who has gone quiet."
    primary={{ label: 'Book a tour', href: '/enroll/book-a-tour', desc: '30 minutes, in person' }}
    secondary={[
      { label: 'Take a look around', href: '/experience/virtual-tour', desc: 'Video walkthrough' },
      { label: 'A day at Tiny Stars', href: '/day', desc: 'What happens in these rooms' },
      { label: 'Programs by age', href: '/programs', desc: 'Which room your child would be in' },
    ]}
  />
</Base>

<style>
  .phero-shell { position: relative; isolation: isolate; }
  .phero-shell > :global(.stage3d--fill) { z-index: 0; opacity: 0.5; }
  .phero-shell > :global(section) { position: relative; z-index: 1; }

  /* ------------------------------------------------------------ filter */
  .gfilter { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .gchip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.55rem 1rem;
    min-height: 44px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-strong);
    background: var(--bg-raised);
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--ink-700);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .gchip:hover { border-color: var(--ink-700); color: var(--ink-900); }
  .gchip[aria-pressed='true'] {
    background: var(--ink-900);
    border-color: var(--ink-900);
    color: var(--cream-100);
  }
  .gchip__n {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--cream-200);
    color: var(--ink-700);
  }
  .gchip[aria-pressed='true'] .gchip__n { background: color-mix(in oklab, #fff 18%, transparent); color: var(--cream-100); }

  /* ---------------------------------------------------------- masonry */
  .gmasonry {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    grid-auto-flow: dense;
  }
  .gitem--wide { grid-column: span 2; }
  @media (max-width: 520px) { .gitem--wide { grid-column: span 1; } }

  .gitem {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--cream-300);
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .gitem[hidden] { display: none; }
  .gitem:hover { transform: translateY(-3px); box-shadow: var(--shadow-l); }
  .gitem img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .gitem:hover img { transform: scale(1.05); }

  .gitem__cap {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 2.5rem 0.85rem 0.75rem;
    background: linear-gradient(to top, color-mix(in oklab, var(--ink-900) 88%, transparent), transparent);
    color: var(--cream-100);
    font-size: var(--step--2);
    font-weight: 600;
    text-align: left;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .gitem:hover .gitem__cap,
  .gitem:focus-visible .gitem__cap { opacity: 1; transform: none; }
  .gitem__cap :global(svg) { flex: none; opacity: 0.8; }

  /* Touch devices never hover — show captions permanently. */
  @media (hover: none) {
    .gitem__cap { opacity: 1; transform: none; }
  }

</style>

<script>
  import { photos } from '../../data/gallery';
  import { track } from '../../lib/analytics';

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const items = Array.from(grid.querySelectorAll<HTMLButtonElement>('.gitem'));
  const VIEWER = JSON.parse(
    document.querySelector('[data-gallery-viewer]')?.textContent || '[]'
  );
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const emptyState = document.querySelector<HTMLElement>('[data-empty]')!;
  const announce = document.querySelector<HTMLElement>('[data-g-announce]')!;

  /* ----------------------------------------------------------- filter */
  function applyFilter(filter: string) {
    let shown = 0;
    items.forEach((el) => {
      const on = filter === 'all' || el.dataset.category === filter;
      el.hidden = !on;
      if (on) shown++;
    });

    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    emptyState.hidden = shown > 0;
    grid.hidden = shown === 0;
    announce.textContent = shown
      ? `Showing ${shown} photograph${shown === 1 ? '' : 's'}.`
      : 'No photographs in that area.';
  }

  chips.forEach((c) => c.addEventListener('click', () => applyFilter(c.dataset.filter!)));
  document.querySelector('[data-show-all]')?.addEventListener('click', () => applyFilter('all'));

  /* ----------------------------------------------------------- viewer */
  // Arrows walk whatever the filter is currently showing, not the whole set —
  // stepping out of the category a parent just chose is disorienting.
  items.forEach((el) =>
    el.addEventListener('click', () => {
      const visible = items.filter((x) => !x.hidden);
      const list = visible.map((x) => VIEWER[Number(x.dataset.index)]);
      const at = visible.indexOf(el);
      track('gallery_open', { index: Number(el.dataset.index) });
      window.tsViewer?.open(list, at, el);
    })
  );
</script>
