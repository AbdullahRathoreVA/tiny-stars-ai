---
import Icon from './Icon.astro';
---

<div class="sdlg" id="search-dialog" hidden>
  <div class="sdlg__scrim" data-search-close></div>

  <div class="sdlg__panel" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <h2 id="search-title" class="visually-hidden">Search Tiny Stars</h2>

    <div class="sdlg__bar">
      <Icon name="search" size={20} class="sdlg__bar-icon" />
      <input
        type="search"
        id="search-input"
        class="sdlg__input"
        placeholder="Search programs, policies, answers…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-describedby="search-help"
      />
      <button type="button" class="sdlg__close" data-search-close aria-label="Close search">
        <Icon name="x" size={18} />
      </button>
    </div>

    <p id="search-help" class="visually-hidden">
      Results update as you type. Use the up and down arrow keys to move between results and Enter to open one.
    </p>

    <div class="sdlg__body" id="search-results" role="listbox" aria-label="Search results">
      <!-- populated by script -->
    </div>

    <div class="sdlg__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
      <span><kbd>↵</kbd> to open</span>
      <span><kbd>Esc</kbd> to close</span>
    </div>
  </div>
</div>

<style>
  .sdlg { position: fixed; inset: 0; z-index: var(--z-overlay); }
  .sdlg__scrim {
    position: absolute; inset: 0;
    background: color-mix(in oklab, var(--ink-900) 48%, transparent);
    backdrop-filter: blur(4px);
    animation: sfade var(--dur) var(--ease-out);
  }
  @keyframes sfade { from { opacity: 0; } to { opacity: 1; } }

  .sdlg__panel {
    position: relative;
    width: min(42rem, calc(100% - 1.5rem));
    max-height: min(34rem, calc(100dvh - 6rem));
    margin: clamp(1rem, 8vh, 6rem) auto 0;
    display: flex;
    flex-direction: column;
    background: var(--cream-50);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    animation: spop var(--dur-slow) var(--ease-out);
  }
  @keyframes spop {
    from { opacity: 0; transform: translateY(-10px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sdlg__scrim, .sdlg__panel { animation: none; }
  }

  .sdlg__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    flex: none;
  }
  :global(.sdlg__bar-icon) { color: var(--text-muted); flex: none; }
  .sdlg__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-size: var(--step-1);
    padding: 0.25rem 0;
    min-height: 40px;
  }
  .sdlg__input:focus { outline: none; }
  .sdlg__input::-webkit-search-cancel-button { display: none; }
  .sdlg__close {
    display: grid; place-items: center;
    width: 36px; height: 36px;
    flex: none;
    border: 0; border-radius: var(--radius-pill);
    background: var(--cream-200);
    color: var(--ink-700);
    cursor: pointer;
  }
  .sdlg__close:hover { background: var(--cream-300); }

  .sdlg__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
  }

  .sdlg__foot {
    display: flex;
    gap: var(--space-m);
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--border);
    background: var(--cream-100);
    font-size: var(--step--2);
    color: var(--text-subtle);
    flex: none;
  }
  .sdlg__foot kbd {
    display: inline-block;
    min-width: 1.4em;
    padding: 0.05em 0.35em;
    margin-right: 0.2em;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--cream-50);
    font-family: var(--font-mono);
    font-size: 0.9em;
    text-align: center;
  }
  @media (max-width: 560px) { .sdlg__foot { display: none; } }
</style>

<!--
  Runtime-injected markup does not receive Astro's scoping attribute, so any rule
  that styles HTML created by the script below must be global. Keeping those rules
  in their own block makes that requirement explicit rather than accidental.
-->
<style is:global>

  .sdlg__group-title {
    padding: 0.75rem 0.75rem 0.35rem;
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .sres {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-m);
    text-decoration: none;
    color: inherit;
    text-align: left;
  }
  .sres:hover, .sres[data-active='true'] { background: var(--cream-200); color: inherit; }
  .sres[data-active='true'] { box-shadow: inset 0 0 0 1.5px var(--coral-500); }

  .sres__icon {
    display: grid; place-items: center;
    width: 34px; height: 34px;
    flex: none;
    border-radius: var(--radius-s);
    background: var(--cream-200);
    color: var(--ink-600);
  }
  .sres[data-kind='action'] .sres__icon { background: var(--coral-100); color: var(--coral-700); }
  .sres[data-kind='program'] .sres__icon { background: var(--teal-100); color: var(--teal-700); }
  .sres[data-kind='document'] .sres__icon { background: var(--violet-100); color: var(--violet-700); }

  .sres__text { min-width: 0; flex: 1; }
  .sres__title {
    display: block;
    font-weight: 650;
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .sres__body {
    display: block;
    font-size: var(--step--2);
    color: var(--text-muted);
    line-height: 1.45;
    margin-top: 0.1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sres :global(mark) {
    background: var(--gold-200);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }

  .sdlg__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.25rem 0.75rem 0.75rem; }
  .sdlg__chip {
    padding: 0.4rem 0.8rem;
    min-height: 36px;
    display: inline-flex; align-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: var(--cream-100);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--ink-700);
    text-decoration: none;
  }
  .sdlg__chip:hover { background: var(--cream-200); border-color: var(--ink-600); color: var(--ink-900); }

  .sdlg__empty { padding: var(--space-l) var(--space-m); text-align: center; }
  .sdlg__empty p { color: var(--text-muted); font-size: var(--step--1); }
  .sdlg__empty strong { display: block; margin-bottom: 0.35rem; font-size: var(--step-0); }
</style>

<script>
  import { searchIndex, popularSearches, kindLabels, type SearchDoc } from '../lib/searchIndex';
  import { highlight, snippet } from '../lib/text';
  import { track } from '../lib/analytics';

  const dialog = document.getElementById('search-dialog')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;

  let activeIndex = -1;
  let current: SearchDoc[] = [];
  let lastFocus: HTMLElement | null = null;
  let queryTimer: number | undefined;

  const ICONS: Record<string, string> = {
    action: '<path d="M4.5 12h14"/><path d="m13 6.5 5.5 5.5L13 17.5"/>',
    program: '<circle cx="12" cy="12" r="8.5"/><path d="m14.8 9.2-1.6 4-4 1.6 1.6-4Z"/>',
    document: '<path d="M13.5 3.5H7.2A1.7 1.7 0 0 0 5.5 5.2v13.6a1.7 1.7 0 0 0 1.7 1.7h9.6a1.7 1.7 0 0 0 1.7-1.7V8.2Z"/><path d="M13.5 3.5v4.7h4.7"/>',
    answer: '<circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.5a2.5 2.5 0 1 1 3.2 2.4c-.5.2-.8.7-.8 1.3v.6"/><path d="M12 16.6v.1"/>',
    page: '<path d="m3.5 11 8.5-7 8.5 7"/><path d="M6 9.6V20h12V9.6"/>',
  };

  const icon = (kind: string) =>
    `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[kind] ?? ICONS.page}</svg>`;

  function renderIdle() {
    current = [];
    activeIndex = -1;
    results.innerHTML = `
      <p class="sdlg__group-title">Families often look for</p>
      <div class="sdlg__chips">
        ${popularSearches
          .map((p) => `<a class="sdlg__chip" href="${p.href}">${p.label}</a>`)
          .join('')}
      </div>`;
  }

  function renderEmpty(q: string) {
    current = [];
    activeIndex = -1;
    results.innerHTML = `
      <div class="sdlg__empty">
        <strong>Nothing matched “${q.replace(/[<>&]/g, '')}”</strong>
        <p>Try a shorter word, or ask the concierge — it can answer in plain language and point you at a person if it does not know.</p>
        <div class="sdlg__chips" style="justify-content:center;margin-top:1rem">
          ${popularSearches
            .slice(0, 4)
            .map((p) => `<a class="sdlg__chip" href="${p.href}">${p.label}</a>`)
            .join('')}
        </div>
      </div>`;
  }

  function render(q: string) {
    const hits = searchIndex.search(q, 12);
    if (!hits.length) {
      track('search_no_results', { q_length: q.length });
      renderEmpty(q);
      return;
    }

    current = hits.map((h) => h.item);
    activeIndex = 0;

    // Group by category while preserving relevance order of first appearance.
    const groups = new Map<string, SearchDoc[]>();
    current.forEach((doc) => {
      if (!groups.has(doc.category)) groups.set(doc.category, []);
      groups.get(doc.category)!.push(doc);
    });

    let i = -1;
    results.innerHTML = Array.from(groups.entries())
      .map(([category, docs]) => {
        const rows = docs
          .map((doc) => {
            i++;
            return `
              <a class="sres" role="option" href="${doc.href}" data-kind="${doc.kind}" data-i="${i}"
                 aria-selected="${i === 0}" data-active="${i === 0}">
                <span class="sres__icon">${icon(doc.kind)}</span>
                <span class="sres__text">
                  <span class="sres__title">${highlight(doc.title, q)}</span>
                  <span class="sres__body">${highlight(snippet(doc.body, q, 130), q)}</span>
                </span>
              </a>`;
          })
          .join('');
        return `<p class="sdlg__group-title">${category} <span class="visually-hidden">results</span></p>${rows}`;
      })
      .join('');
  }

  function setActive(next: number) {
    const rows = results.querySelectorAll<HTMLElement>('.sres');
    if (!rows.length) return;
    activeIndex = (next + rows.length) % rows.length;
    rows.forEach((row, i) => {
      const on = i === activeIndex;
      row.dataset.active = String(on);
      row.setAttribute('aria-selected', String(on));
      if (on) row.scrollIntoView({ block: 'nearest' });
    });
  }

  function open() {
    if (!dialog.hidden) return;
    lastFocus = document.activeElement as HTMLElement;
    dialog.hidden = false;
    document.body.style.overflow = 'hidden';
    renderIdle();
    input.value = '';
    input.focus();
    track('search_open');
  }

  function close() {
    if (dialog.hidden) return;
    dialog.hidden = true;
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  document.querySelectorAll('[data-search-open]').forEach((el) =>
    el.addEventListener('click', open)
  );
  document.addEventListener('ts:search-open', open);
  dialog.querySelectorAll('[data-search-close]').forEach((el) =>
    el.addEventListener('click', close)
  );

  input.addEventListener('input', () => {
    const q = input.value.trim();
    window.clearTimeout(queryTimer);
    if (!q) {
      renderIdle();
      return;
    }
    // Render immediately (it is fast), but only record the analytics event once
    // the visitor has paused — otherwise every keystroke becomes a "search".
    render(q);
    queryTimer = window.setTimeout(() => {
      track('search_query', { q_length: q.length, results: current.length });
    }, 500);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex - 1);
    } else if (e.key === 'Enter') {
      const row = results.querySelector<HTMLAnchorElement>(`.sres[data-i="${activeIndex}"]`);
      if (row) {
        e.preventDefault();
        track('search_result_click', { kind: row.dataset.kind ?? '' });
        window.location.href = row.href;
      }
    } else if (e.key === 'Home') {
      e.preventDefault();
      setActive(0);
    } else if (e.key === 'End') {
      e.preventDefault();
      setActive(current.length - 1);
    }
  });

  results.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLAnchorElement>('.sres');
    if (row) track('search_result_click', { kind: row.dataset.kind ?? '' });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !dialog.hidden) {
      e.stopPropagation();
      close();
    }
  });

  // Keep focus inside the dialog.
  dialog.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusables = dialog.querySelectorAll<HTMLElement>('input, button, a[href]');
    const list = Array.from(focusables).filter((el) => el.offsetParent !== null);
    if (!list.length) return;
    const first = list[0];
    const last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
