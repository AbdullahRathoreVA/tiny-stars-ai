---
/**
 * The single mount point for every 3D scene on the site.
 *
 * It is a positioned box with a `data-scene` name. A tiny loader script maps
 * that name to a dynamically imported scene module, and only after the element
 * is near the viewport *and* the device has been judged capable. Three.js never
 * appears in the initial bundle, and never downloads at all on a device that
 * would not enjoy it.
 *
 * Anything in the default slot is the fallback: it renders immediately, stays
 * in the DOM, and is what a visitor sees if WebGL is missing, the import fails,
 * the context is lost, or reduced motion is on. That is the whole failure
 * strategy — there is no error state to design, because the good state was
 * never removed.
 */

export type SceneName = 'hero' | 'constellation' | 'day' | 'programs' | 'agents' | 'gallery';

interface Props {
  scene: SceneName;
  class?: string;
  /** Ratio applied when the parent does not set a height. */
  ratio?: string;
  /** Marks the scene as purely decorative for assistive tech. */
  decorative?: boolean;
  /**
   * Absolutely fill the nearest positioned ancestor. Exposed as a prop because
   * a class passed in from a parent's *scoped* stylesheet never matches this
   * root element — Astro scopes by template, not by class.
   */
  fill?: boolean;
}

const { scene, class: cls = '', ratio, decorative = false, fill = false } = Astro.props;
---

<div
  class:list={['stage3d', { 'stage3d--fill': fill }, cls]}
  data-scene={scene}
  style={ratio ? `--stage-ratio:${ratio}` : undefined}
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="stage3d__fallback"><slot /></div>
</div>

<style>
  .stage3d {
    position: relative;
    isolation: isolate;
  }
  .stage3d--fill {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .stage3d[style*='--stage-ratio'] { aspect-ratio: var(--stage-ratio); }

  /* The fallback sits underneath. Once a canvas is live it fades back but is
     never removed — losing the context mid-session must not blank the box. */
  .stage3d__fallback {
    position: absolute;
    inset: 0;
    transition: opacity var(--dur-slower) var(--ease-out);
  }
  .stage3d[data-stage='ready'] .stage3d__fallback { opacity: 0; }

  /* A canvas is decoration behind real HTML unless a scene turns this on. */
  .stage3d :global(canvas) { z-index: 1; }
</style>

<script>
  import { mountStage } from '../../lib/three/stage';
  import { quality, hasWebGL, prefersReducedMotion } from '../../lib/three/quality';

  const LOADERS = {
    hero: () => import('../../lib/three/scenes/hero'),
    constellation: () => import('../../lib/three/scenes/constellation'),
    day: () => import('../../lib/three/scenes/day'),
    programs: () => import('../../lib/three/scenes/programs'),
    agents: () => import('../../lib/three/scenes/agents'),
    gallery: () => import('../../lib/three/scenes/gallery'),
  } as const;

  type SceneName = keyof typeof LOADERS;

  const q = quality();

  // Expose the decision once, so CSS can style the 2D-only experience properly
  // rather than leaving gaps where a canvas would have been.
  document.documentElement.dataset.tsQuality = q.tier;
  document.documentElement.dataset.tsWebgl = String(hasWebGL());
  if (prefersReducedMotion()) document.documentElement.dataset.tsMotion = 'reduced';

  const disposers: (() => void)[] = [];

  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((el) => {
    const name = el.dataset.scene as SceneName;
    const load = LOADERS[name];
    if (!load) return;
    disposers.push(mountStage(el, load as () => Promise<{ create: (m: HTMLElement) => any }>));
  });

  // Astro's view transitions reuse the document; dispose before the swap.
  document.addEventListener('astro:before-swap', () => {
    disposers.forEach((d) => d());
    disposers.length = 0;
  });
</script>
