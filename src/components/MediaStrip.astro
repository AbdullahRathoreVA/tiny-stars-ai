---
/**
 * The centre's own photographs and clips, as a strip.
 *
 * Mobile gets a horizontal snap rail rather than a stacked grid. A grid of eight
 * portrait cards is eight screens of scrolling on a phone; the rail is one, and
 * a thumb already knows what to do with it. Desktop gets the grid, where the
 * height is free.
 *
 * Videos never autoplay. A parent may well be opening this at 11pm next to a
 * sleeping child, and sound arriving uninvited is how a tab gets closed.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Icon from './Icon.astro';
import MediaViewer from './MediaViewer.astro';
import { featured, photoSrc, posterSrc, videoSrc, type MediaItem } from '../data/media';

interface Props {
  items?: MediaItem[];
  heading?: string;
  eyebrow?: string;
  lede?: string;
}

const {
  items = featured(),
  eyebrow = 'Inside Tiny Stars',
  heading = 'The actual rooms, the actual yard',
  lede = 'Photographs and clips from the centre itself — not stock images of somebody else’s daycare.',
} = Astro.props;

const poster = (m: MediaItem) => (m.kind === 'video' ? posterSrc(m.id) : photoSrc(m.id, 700));

// Track files are generated by `scripts/captions.py`. Descriptions always
// exist; real captions only appear once someone has run the transcribe pass,
// so their presence is checked rather than assumed — offering an empty
// captions track is worse than offering none.
// Resolved from the project root, not import.meta.url: during the build this
// module is evaluated from a bundled chunk, so a relative URL points at the
// output tree rather than at public/.
const TRACK_DIR = join(process.cwd(), 'public', 'assets', 'media', 'tracks');
const TRACK_URL = '/assets/media/tracks';
const hasTrack = (file: string) => existsSync(join(TRACK_DIR, file));

const tracks = (m: MediaItem) => ({
  descriptions: hasTrack(`${m.id}.desc.vtt`) ? `${TRACK_URL}/${m.id}.desc.vtt` : '',
  captions: hasTrack(`${m.id}.vtt`) ? `${TRACK_URL}/${m.id}.vtt` : '',
});
---

<section class="section mstrip" aria-labelledby="mstrip-title">
  <div class="container">
    <div class="mstrip__head" data-reveal>
      <div class="section-head">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="mstrip-title">{heading}</h2>
        <p class="lede">{lede}</p>
      </div>
      <a href="/experience/gallery" class="btn btn--ghost mstrip__all">
        <Icon name="camera" size={18} />
        See all
      </a>
    </div>
  </div>

  <!-- The rail breaks out of the container on mobile so cards can bleed to the
       screen edge, which is what tells a thumb it scrolls. -->
  <ul class="mstrip__rail" data-media-rail>
    {items.map((m, i) => (
      <li class="mstrip__cell">
        <button
          type="button"
          class="mcard"
          data-media-open={i}
          aria-label={`Open: ${m.caption}`}
          style={`--ar:${m.w} / ${m.h}`}
        >
          <img
            src={poster(m)}
            alt=""
            width={m.w}
            height={m.h}
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {m.kind === 'video' && (
            <span class="mcard__play" aria-hidden="true">
              <Icon name="play" size={18} />
            </span>
          )}
          <span class="mcard__cap">{m.caption}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<MediaViewer />

<script is:inline define:vars={{ ITEMS: items.map((m) => ({
  kind: m.kind, alt: m.alt, caption: m.caption, generated: !!m.generated,
  img: m.kind === 'photo' ? photoSrc(m.id, 1400) : '',
  video: m.kind === 'video' ? videoSrc(m.id) : '',
  poster: m.kind === 'video' ? posterSrc(m.id) : '',
  tracks: m.kind === 'video' ? tracks(m) : {},
})) }}>
  document.querySelectorAll('[data-media-open]').forEach((btn) => {
    btn.addEventListener('click', () =>
      window.tsViewer?.open(ITEMS, Number(btn.dataset.mediaOpen), btn)
    );
  });
</script>

<style>
  .mstrip { overflow: hidden; }

  .mstrip__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
  }
  .mstrip__all { flex: none; }

  .mstrip__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 15rem);
    gap: var(--space-s);
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0 var(--gutter) var(--space-xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .mstrip__rail::-webkit-scrollbar { display: none; }
  .mstrip__cell { scroll-snap-align: start; }

  .mcard {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--cream-200);
    cursor: pointer;
    box-shadow: var(--shadow-s);
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .mcard img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mcard:hover { transform: translateY(-2px); box-shadow: var(--shadow-m); }
  .mcard:active { transform: scale(0.985); }

  .mcard__play {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ink-900) 62%, transparent);
    color: #fff;
    backdrop-filter: blur(6px);
  }

  .mcard__cap {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.6rem 0.7rem 0.6rem;
    text-align: left;
    font-size: var(--step--1);
    font-weight: 600;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.62), transparent);
  }

  @media (min-width: 900px) {
    .mstrip__rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      padding-inline: 0;
      max-width: var(--container);
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mcard { transition: none; }
  }
</style>
