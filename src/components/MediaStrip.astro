---
/**
 * The centre's own photographs and clips, as a strip.
 *
 * Mobile gets a horizontal snap rail rather than a stacked grid. A grid of eight
 * portrait cards is eight screens of scrolling on a phone; the rail is one, and
 * a thumb already knows what to do with it. Desktop gets the grid, where the
 * height is free.
 *
 * Videos never autoplay. A parent may well be opening this at 11pm next to a
 * sleeping child, and sound arriving uninvited is how a tab gets closed.
 */
import Icon from './Icon.astro';
import { featured, photoSrc, posterSrc, videoSrc, type MediaItem } from '../data/media';

interface Props {
  items?: MediaItem[];
  heading?: string;
  eyebrow?: string;
  lede?: string;
}

const {
  items = featured(),
  eyebrow = 'Inside Tiny Stars',
  heading = 'The actual rooms, the actual yard',
  lede = 'Photographs and clips from the centre itself — not stock images of somebody else’s daycare.',
} = Astro.props;

const poster = (m: MediaItem) => (m.kind === 'video' ? posterSrc(m.id) : photoSrc(m.id, 700));
---

<section class="section mstrip" aria-labelledby="mstrip-title">
  <div class="container">
    <div class="mstrip__head" data-reveal>
      <div class="section-head">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="mstrip-title">{heading}</h2>
        <p class="lede">{lede}</p>
      </div>
      <a href="/experience/gallery" class="btn btn--ghost mstrip__all">
        <Icon name="camera" size={18} />
        See all
      </a>
    </div>
  </div>

  <!-- The rail breaks out of the container on mobile so cards can bleed to the
       screen edge, which is what tells a thumb it scrolls. -->
  <ul class="mstrip__rail" data-media-rail>
    {items.map((m, i) => (
      <li class="mstrip__cell">
        <button
          type="button"
          class="mcard"
          data-media-open={i}
          aria-label={`Open: ${m.caption}`}
          style={`--ar:${m.w} / ${m.h}`}
        >
          <img
            src={poster(m)}
            alt=""
            width={m.w}
            height={m.h}
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {m.kind === 'video' && (
            <span class="mcard__play" aria-hidden="true">
              <Icon name="play" size={18} />
            </span>
          )}
          <span class="mcard__cap">{m.caption}</span>
        </button>
      </li>
    ))}
  </ul>
</section>

<!-- ------------------------------------------------------------- viewer -->
<div class="mv" data-media-viewer hidden>
  <div class="mv__scrim" data-mv-close></div>
  <div class="mv__panel" role="dialog" aria-modal="true" aria-label="Media viewer">
    <button type="button" class="mv__btn mv__btn--close" data-mv-close aria-label="Close">
      <Icon name="x" size={20} />
    </button>
    <button type="button" class="mv__btn mv__btn--prev" data-mv-step="-1" aria-label="Previous">
      <Icon name="chevron" size={22} />
    </button>

    <figure class="mv__figure">
      <img data-mv-image alt="" hidden />
      <video data-mv-video controls playsinline preload="none" hidden></video>
      <figcaption>
        <span data-mv-caption></span>
        <small data-mv-note hidden>AI-generated. Not footage of the real centre.</small>
      </figcaption>
    </figure>

    <button type="button" class="mv__btn mv__btn--next" data-mv-step="1" aria-label="Next">
      <Icon name="chevron" size={22} />
    </button>
    <p class="mv__count" data-mv-count></p>
  </div>
</div>

<script is:inline define:vars={{ ITEMS: items.map((m) => ({
  id: m.id, kind: m.kind, alt: m.alt, caption: m.caption, generated: !!m.generated,
  img: m.kind === 'photo' ? photoSrc(m.id, 1400) : '',
  video: m.kind === 'video' ? videoSrc(m.id) : '',
  poster: m.kind === 'video' ? posterSrc(m.id) : '',
})) }}>
  (() => {
    const viewer = document.querySelector('[data-media-viewer]');
    if (!viewer) return;
    const image = viewer.querySelector('[data-mv-image]');
    const video = viewer.querySelector('[data-mv-video]');
    const caption = viewer.querySelector('[data-mv-caption]');
    const note = viewer.querySelector('[data-mv-note]');
    const count = viewer.querySelector('[data-mv-count]');
    const panel = viewer.querySelector('.mv__panel');
    let index = 0;
    let opener = null;

    const show = (i) => {
      index = (i + ITEMS.length) % ITEMS.length;
      const m = ITEMS[index];

      // Always stop whatever was playing before swapping source, or audio from
      // the previous clip keeps running over the next one.
      video.pause();

      if (m.kind === 'video') {
        video.src = m.video;
        video.poster = m.poster;
        video.setAttribute('aria-label', m.alt);
        video.hidden = false;
        image.hidden = true;
        image.removeAttribute('src');
      } else {
        image.src = m.img;
        image.alt = m.alt;
        image.hidden = false;
        video.hidden = true;
        video.removeAttribute('src');
        video.load();
      }
      caption.textContent = m.caption;
      note.hidden = !m.generated;
      count.textContent = `${index + 1} of ${ITEMS.length}`;
    };

    const open = (i, from) => {
      opener = from || null;
      viewer.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      show(i);
      panel.querySelector('.mv__btn--close').focus();
    };

    const close = () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
      viewer.hidden = true;
      document.documentElement.style.overflow = '';
      // Send focus back where it came from, or the page reads as having jumped.
      if (opener && document.contains(opener)) opener.focus();
      opener = null;
    };

    document.querySelectorAll('[data-media-open]').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.mediaOpen), btn));
    });
    viewer.querySelectorAll('[data-mv-close]').forEach((el) =>
      el.addEventListener('click', close)
    );
    viewer.querySelectorAll('[data-mv-step]').forEach((el) =>
      el.addEventListener('click', () => show(index + Number(el.dataset.mvStep)))
    );

    document.addEventListener('keydown', (e) => {
      if (viewer.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(index + 1);
      else if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'Tab') {
        // Keep tabbing inside the dialog while it is open.
        const focusable = [...panel.querySelectorAll('button, video[controls]')].filter(
          (el) => !el.hidden && el.offsetParent !== null
        );
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // Swipe, for the hand that is already holding the phone.
    let x0 = null;
    panel.addEventListener('touchstart', (e) => { x0 = e.changedTouches[0].clientX; }, { passive: true });
    panel.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 55) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    }, { passive: true });
  })();
</script>

<style>
  .mstrip { overflow: hidden; }

  .mstrip__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
  }
  .mstrip__all { flex: none; }

  .mstrip__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 15rem);
    gap: var(--space-s);
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0 var(--gutter) var(--space-xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .mstrip__rail::-webkit-scrollbar { display: none; }
  .mstrip__cell { scroll-snap-align: start; }

  .mcard {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--cream-200);
    cursor: pointer;
    box-shadow: var(--shadow-s);
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .mcard img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mcard:hover { transform: translateY(-2px); box-shadow: var(--shadow-m); }
  .mcard:active { transform: scale(0.985); }

  .mcard__play {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ink-900) 62%, transparent);
    color: #fff;
    backdrop-filter: blur(6px);
  }

  .mcard__cap {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1.6rem 0.7rem 0.6rem;
    text-align: left;
    font-size: var(--step--1);
    font-weight: 600;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.62), transparent);
  }

  @media (min-width: 900px) {
    .mstrip__rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      padding-inline: 0;
      max-width: var(--container);
      margin-inline: auto;
    }
  }

  /* ---------------------------------------------------------- viewer -- */
  .mv {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 90);
    display: grid;
    place-items: center;
  }
  .mv[hidden] { display: none; }
  .mv__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--ink-900) 88%, transparent);
    backdrop-filter: blur(4px);
  }
  .mv__panel {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-xs);
    width: min(100%, 68rem);
    padding: 3.2rem 0.5rem calc(2.6rem + env(safe-area-inset-bottom, 0px));
  }
  .mv__figure {
    grid-column: 2;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .mv__figure img,
  .mv__figure video {
    max-width: 100%;
    max-height: min(70vh, 40rem);
    border-radius: var(--radius-m);
    background: #000;
  }
  .mv__figure figcaption {
    color: var(--cream-100);
    font-size: var(--step--1);
    text-align: center;
    display: grid;
    gap: 0.2rem;
  }
  .mv__figure small { color: var(--gold-200); font-weight: 650; }

  .mv__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: color-mix(in oklab, var(--cream-50) 16%, transparent);
    color: #fff;
    cursor: pointer;
  }
  .mv__btn:hover { background: color-mix(in oklab, var(--cream-50) 28%, transparent); }
  .mv__btn--close { position: absolute; top: 0.6rem; right: 0.6rem; }
  /* One chevron asset, mirrored for the back direction. */
  .mv__btn--prev :global(svg) { transform: rotate(180deg); }
  .mv__count {
    position: absolute;
    bottom: calc(0.8rem + env(safe-area-inset-bottom, 0px));
    inset-inline: 0;
    text-align: center;
    color: color-mix(in oklab, var(--cream-100) 70%, transparent);
    font-size: var(--step--2);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .mcard { transition: none; }
  }
</style>
