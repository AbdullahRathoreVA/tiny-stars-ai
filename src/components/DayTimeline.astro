---
/**
 * The shape of a day, on the homepage.
 *
 * A horizontal rail rather than a stacked list: eight steps stacked is eight
 * screens on a phone, and this is meant to be a glance, not a document. The
 * full version with the room and the camera routes lives at /day.
 *
 * Photographs are attached only where one genuinely shows that part of the day.
 * Five of the eight have one; the other three get the icon. Padding rest and
 * meals with whatever image was nearest would be the same fabrication the rest
 * of the site refuses — and a parent looking for "what happens at nap time"
 * would be the person it misled.
 *
 * No times. Tiny Stars publishes its own Classroom Routine and that document is
 * the authority; inventing a schedule to make a prettier timeline is exactly
 * the trade this project does not make.
 */
import Icon from './Icon.astro';
import { dayZones } from '../data/dayZones';
import { photoSrc, posterSrc, publishable } from '../data/media';

/** Only where the picture is actually of that moment. */
const IMAGE_FOR: Record<string, string> = {
  arrival: 'ts-24',
  learning: 'ts-06',
  play: 'ts-25',
  creative: 'ts-28',
  outdoor: 'ts-09',
};

const available = new Set(publishable().map((m) => m.id));
const kindOf = new Map(publishable().map((m) => [m.id, m.kind]));

const steps = dayZones.map((z) => {
  const id = IMAGE_FOR[z.id];
  const usable = id && available.has(id);
  return {
    ...z,
    img: usable ? (kindOf.get(id) === 'video' ? posterSrc(id) : photoSrc(id, 700)) : null,
  };
});
---

<section class="section dayline" aria-labelledby="dayline-title">
  <div class="container">
    <div class="dayline__head" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Their day</p>
        <h2 id="dayline-title">What happens between goodbye and hello</h2>
        <p class="lede">
          The shape of it, in order. Exact times come from Tiny Stars' own Classroom
          Routine, not from us.
        </p>
      </div>
      <a href="/day" class="btn btn--ghost dayline__all">
        <Icon name="route" size={18} />
        See the whole day
      </a>
    </div>
  </div>

  <ol class="dayline__rail">
    {steps.map((s, i) => (
      <li class="dstep">
        <a href={`/day#${s.id}`} class="dstep__link">
          <span class="dstep__media">
            {s.img ? (
              <img src={s.img} alt="" width="400" height="300" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            ) : (
              <span class="dstep__icon" aria-hidden="true"><Icon name={s.icon as any} size={26} /></span>
            )}
            <span class="dstep__n" aria-hidden="true">{i + 1}</span>
          </span>
          <span class="dstep__body">
            <strong>{s.label}</strong>
            <small>{s.hint}</small>
            <span class={`badge badge--${s.trust === 'verified' ? 'verified' : 'general'} dstep__badge`}>
              {s.trust === 'verified' ? 'Published' : 'General guidance'}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .dayline__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
  }
  .dayline__all { flex: none; }

  .dayline__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(58vw, 13.5rem);
    gap: var(--space-s);
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0 var(--gutter) var(--space-2xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    counter-reset: step;
  }
  .dayline__rail::-webkit-scrollbar { display: none; }
  .dstep { scroll-snap-align: start; min-width: 0; }

  .dstep__link {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .dstep__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--cream-200);
    box-shadow: var(--shadow-s);
  }
  .dstep__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dstep__icon { color: var(--ink-500); }

  .dstep__n {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink-900);
    color: var(--cream-50);
    font-size: var(--step--2);
    font-weight: 700;
  }

  .dstep__body { display: grid; gap: 0.15rem; }
  .dstep__body strong { font-size: var(--step-0); }
  .dstep__body small {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }
  .dstep__badge { justify-self: start; margin-top: 0.3rem; }

  .dstep__link:hover .dstep__media { box-shadow: var(--shadow-m); }

  @media (min-width: 900px) {
    .dayline__rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      padding-inline: 0;
      max-width: var(--container);
      margin-inline: auto;
      row-gap: var(--space-l);
    }
  }
</style>
